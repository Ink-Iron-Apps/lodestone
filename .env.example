# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=lodestone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lodestone

# openssl rand -hex 32
MEILI_MASTER_KEY=change-me

# Used by the crawler outside Docker.
LODESTONE_DSN=postgresql://lodestone:change-me@localhost:5433/lodestone

# Local embedding server (Ollama by default). Must serve a model whose
# width matches EMBEDDING_DIMENSIONS in crawler/lodestone_crawler/embeddings.py.
LODESTONE_EMBEDDING_HOST=http://127.0.0.1:11434
LODESTONE_EMBEDDING_MODEL=nomic-embed-text
