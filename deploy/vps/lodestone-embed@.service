[Unit]
Description=Lodestone summary embedding worker %i
Documentation=https://github.com/Ink-Iron-Apps/lodestone
After=network-online.target postgresql.service ollama.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=riley
WorkingDirectory=/home/riley/coding/lodestone
ExecStart=/home/riley/coding/lodestone/scripts/dev.sh crawl embed --batch-size 32

# RUN ONE INSTANCE: `systemctl enable --now lodestone-embed@1`.
#
# Templated because the workers can safely run concurrently -- each claims its
# own rows with FOR UPDATE SKIP LOCKED, so nothing has to be told how many
# siblings exist, and stopping one returns its rows to the pool. Safe to run
# several is not the same as worth running several, and here it is not.
#
# A second worker makes throughput WORSE. Measured 2026-10-28 back to back on an
# otherwise idle box, 12 minutes each:
#
#     1 worker   1152 rows / 754s = 5500/hour
#     2 workers   736 rows / 737s = 3595/hour
#
# One worker is 1.53x the pair. llama-server splitting 8 shared cores across two
# inference streams costs more than the concurrency returns.
#
# An earlier note here claimed two was the measured sweet spot, citing Ollama
# serving four concurrent batches 2.49x faster than four in sequence. That
# measurement was taken while Crucible held seven connections to the same model
# server, so it measured how much of a contended server a second caller can
# win -- not whether the server does more total work. It does not. Scale this
# past one only against a fresh A/B on an idle box.
#
# Embedding is now this worker's job alone. backfill-all used to also embed
# inline; that pass drained the whole pending queue rather than a slice, so a
# 164,725-row backlog stopped the crawl for 28 hours on 2026-10-27.
#
# The command exits once nothing is pending, so the restart is the poll loop.
Restart=always
RestartSec=60

# The model server here is CPU-only rather than the desktop's GPU. That is fine
# for the steady state -- only newly crawled summaries need embedding -- but it
# is the reason this yields rather than competing with the API for cores.
Nice=15
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
MemoryMax=1G

StandardOutput=append:/var/log/lodestone-embed-%i.log
StandardError=append:/var/log/lodestone-embed-%i.log
SyslogIdentifier=lodestone-embed-%i

[Install]
WantedBy=multi-user.target
